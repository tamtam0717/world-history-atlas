  "_why_world_adm2": {
    "IND": "ムガル帝国の解体、マラーター・マイソール、東インド会社の段階的な拡大、藩王国、仏領（ポンディシェリ・カーリカール・マーヘ・ヤナム）、ポルトガル領（ゴア・ダマン・ディウ・ダードラー＝ナガル・ハヴェーリー）",
    "PAK": "シンド・パンジャーブ・バローチスターンの藩王国（カラート・バハーワルプル・ハイルプル）、北西辺境と部族地域、ギルギット＝バルティスタン（フンザ・ナガル）",
    "BGD": "1666 ムガル帝国のチッタゴン征服（それまでアラカン）、1947 シレットの住民投票",
    "LKA": "ポルトガル・オランダの沿岸領とキャンディ王国、ジャフナ王国",
    "NPL": "ゴルカ朝の統一（1768 カトマンズ盆地）、1816 スガウリ条約、1860 タライ西部（ナヤ・ムルク）の返還",
    "MMR": "1826・1852・1885 の英緬戦争（1852 の境界はタエッ・タウングーの県）、シャン諸州・カレンニー",
    "PHL": "スペインの段階的な支配（コルディリェラ、ミンダナオのマギンダナオ王国・スールー王国）",
    "IDN": "VOC・オランダの段階的な拡大（ジャワの県単位の割譲、マタラムの分裂、バリの諸王国、マカッサル、アンボン・バンダ、ティモール西部）。パプアは州のまま",
    "LAO": "1904 メコン右岸（チャンパーサック西部）のフランスへの割譲、1941 タイへの割譲",
    "VNM": "ザイン川（クアンビン）の鄭氏・阮氏の境界、1954 の北緯17度線（ベンハイ川、クアンチのヴィンリン県が北）",
    "MYS": "ペナン島（1786）とウェルズリー州（1800）、ディンディングス（ペラのマンジュン、1874–1935）、サラワクの段階的な拡大（リンバン 1890・ラワス 1905）",
    "USA": "郡単位にした州：ルイジアナ購入の西の境（大陸分水嶺・アーカンソー川・1819 年アダムズ＝オニス条約の線）と北の境（レッド川流域、1818 年の北緯49度）が横切る MT・WY・CO・KS・OK・MN・ND、テキサス共和国の主張範囲とヌエセス川の係争地（TX・NM・CO・KS・OK・WY）、メキシコ割譲・ガズデン購入（AZ・NM）、ロシアのフォート・ロス（CA）、サンフアン諸島（WA）、西フロリダ・ボルトン・ルージュ・モビール（LA・MS・AL・FL、アパラチコラ川が東西フロリダの境）、1763 年の宣言線とインディアン保留地（NY・PA・VA・WV・NC・SC・GA）、ニューネーデルラント・ニュースウェーデン・東西ジャージー・プリマス植民地・ニューヘイヴン植民地・メイン（NY・NJ・MA・CT・ME）、オクラホマのインディアン準州と無主地（パンハンドル）・グリア郡。ほかの州（KY・TN・OH など）は州のまま。名前は「郡名, 州の略号」",
    "CAN": "ケベック・オンタリオ・ノヴァスコシアは CGAZ ADM2（経済圏。CGAZ にセンサス区分はない）。ケベック植民地（1763 の範囲・1774）、ルパートランド（ハドソン湾流域）との境、ケープブレトン島。さらに split で 1898・1912 の拡大などを近似",
    "MEX": "チアパスのソコヌスコ（1824–42 グアテマラとの係争、1842 メキシコが併合）",
    "CHL": "州（provincia）単位：アラウカニア（マプチェ、1883 まで）、アリカ・タラパカ（ペルー領、1883/84）、アントファガスタ（ボリビア領の沿岸。南緯24度の線で split）、イースター島（1888）",
    "PER": "タクナ（1880–1929 チリ占領、タラタは 1925 返還）、ロレト（1922 サロモン＝ロサノ条約・1942 リオ議定書の境）",
    "PRY": "チャコ戦争（1932–35）：チャコ北部の要塞線と 1938 年の講和の境",
    "ARG": "プーナ・デ・アタカマ（1899 ボリビア・チリから。ロス・アンデス県・ススケス・アントファガスタ・デ・ラ・シエラ）、タリハの係争地（イルヤ・サンタ・ビクトリア）",
    "BRA": "ピラーラ係争（1904 イギリス領ギアナとの仲裁。ロライマ東部の郡）"
  },
